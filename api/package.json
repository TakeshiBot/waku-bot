{
  "name": "waku-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --loader:.sql=text --outfile=.test/worker.mjs",
    "test": "npm run build && tsx --test spec/*.spec.ts",
    "deploy": "node scripts/deploy.mjs",
    "webhook": "node scripts/webhook.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "db:d1": "node scripts/return-d1.mjs",
    "db:vps": "node scripts/return-libsql.mjs",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "5.20261023.1-beta",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.154.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
