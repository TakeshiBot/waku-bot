# Python environments, bytecode and tool caches.
.venv*/
venv/
venv-*/
env/
ENV/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.pyrefly_cache/
.hypothesis/
.tox/
.nox/

# Test coverage and generated Python packages.
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage/
*.egg-info/
.eggs/
/build/
/dist/

# Bot runtime data, logs and Telegram authentication sessions.
/data/
logs/
tmp/
*.log
*.pid
*.session
*.session-*
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
/unknown_errors.txt
pgload/

# Local settings. Keep sanitized examples in version control.
settings*.toml
.settings-editor-*
!settings.ex.toml
!settings.example.toml
!settings.sample.toml
.secret*

# Environment files may contain tokens, API keys or signed initData.
.env
.env.*
*.env
*.env.*
.envrc
.envrc.*
!.env.example
!.env.sample
!.env.template
!.env.dist
!*.env.example
!*.env.sample
!*.env.template
!*.env.dist
!.envrc.example

# Mini App dependencies, frontend caches and generated bundles.
node_modules/
.pnpm-store/
.npm/
.vite/
*.tsbuildinfo
/webapp/dist/
/waku/webapp/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated documentation; keep docs source and assets.
/site/
/docs/site/

# VPS deployment settings and private backups managed by run.sh.
/config/
/.backups/
/.run.lock
/.dev-notes-nginx-*

# Local assistant state and working notes, including private config backups.
.agentfs/
.dev-notes/
.omp/
.claude/
.codex/
.opencode/
.codegraph/

# Root-level scratch files; do not hide tests/ or frontend test source.
/test*.py
/test*.json
/test*.db

# Editor, operating system and temporary backup files.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.bak
