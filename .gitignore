__pycache__
*venv*
*.log
# Kurigram runtime RPC diagnostics.
/unknown_errors.txt
tmp/
logs/
.idea
.vscode
# Local runtime settings. Only sanitized examples belong in the repository.
settings*.toml
.settings-editor-*
!settings.ex.toml
!settings.example.toml
!settings.sample.toml
data/**
.secret*
pgload/
.agentfs

# Root-level scratch files (test.py, test2.py, test.json, test_powermem.json).
# Scoped to the repo root with a leading slash: a bare *test* pattern also matches
# conftest.py, tests/test_*.py and vitest.config.ts, which hides the real suite.
/test*.py
/test*.json
/test*.db

# Mini App panel: frontend deps, caches and build output
webapp/node_modules/
webapp/dist/
webapp/.vite/
webapp/*.tsbuildinfo
waku/webapp/dist/
# Environment files can contain API keys, bot tokens and signed initData.
.env
.env.*
*.env
*.env.*
.envrc
.envrc.*
env/
# Keep sanitized environment templates available for fresh checkouts.
!.env.example
!.env.sample
!.env.template
!.env.dist
!*.env.example
!*.env.sample
!*.env.template
!*.env.dist
!.envrc.example
# Telegram session files contain authentication data.
*.session
*.session-*

# Working notes: design plans, local dev scratch. Not user documentation, so they
# stay out of the repo and out of the docs site.
.dev-notes/
# Runtime configuration with real credentials - never commit.
.omp/
.claude/
.codex/
.opencode/
.codegraph/
